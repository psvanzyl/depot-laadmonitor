-- one-time setup on the host:
--   createuser depotmon -P            (or use the docker compose db)
--   createdb depotmon -O depotmon
--   psql -d depotmon -c 'CREATE EXTENSION postgis;'
DATABASE_URL=postgresql://depotmon:depotmon@localhost:5432/depotmon

# storage
RAW_DIR=/data/raw
REPORT_DIR=/data/reports

# politeness
USER_AGENT=depot-laadmonitor/0.1 (+https://github.com/psvanzyl/depot-laadmonitor; contact psvanzyl@gmail.com)
MIN_INTERVAL=1.0
OVERPASS_INTERVAL=5.0
RESPECT_ROBOTS=true

# ingest windows
PERMIT_LOOKBACK_DAYS=10
PERMIT_MAX_RECORDS=400
PERMIT_FETCH_DOCS=true
MIN_POWER_KW=100
RDW_MONTHS=18

# optional sources / flags
OCM_API_KEY=
LLM_CLASSIFY=false
LLM_BASE_URL=http://192.168.178.162:1933/v1
LLM_MODEL=gpt-oss:120b
LLM_API_KEY=
AERIAL_VERIFY=false

# alerts
ALERT_WEBHOOK_URL=
COUNT_DEVIATION_FACTOR=3.0
